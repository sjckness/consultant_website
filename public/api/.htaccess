# Cartella API dell'editor testi
Options -Indexes
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "no-store"
</IfModule>
# lib.php e config.php non devono mai essere raggiungibili direttamente
<FilesMatch "^(lib|config|config\.sample)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
