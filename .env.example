# Database (SQLite — created automatically by `prisma db push`)
# IMPORTANT: use an absolute path in production (Passenger does not guarantee working directory).
# On Plesk, set this in the Node.js panel → Environment Variables, not in a .env file.
# Example (local dev):      DATABASE_URL="file:./prisma/dev.db"
# Example (Plesk/prod):     DATABASE_URL="file:/var/www/vhosts/steffensinfraport.ch/httpdocs/prisma/prod.db"
DATABASE_URL="file:/absolute/path/to/prisma/prod.db"

# Contact form email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
CONTACT_TO_EMAIL="owner@example.com"
CONTACT_FROM_EMAIL="noreply@example.com"

# Admin submissions page password (/admin)
ADMIN_PASSWORD="set-a-strong-password"
